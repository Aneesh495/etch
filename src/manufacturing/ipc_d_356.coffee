###
# Etch EDA: IPC-D-356 Bare-Board Electrical Test Netlist Generator
#
# Generates standard IPC-D-356 netlists for automated flying-probe bare-board
# continuity and isolation testing. Emits record types 317 (Through-Hole)
# and 327 (Surface Mount) with physical probe coordinates and pad sizes.
###

Units = require '../core/units'

class IPCD356Exporter
  # Export IPC-D-356 electrical test netlist
  @exportNetlist: (board) ->
    lines = []
    lines.push "C  IPC-D-356 Electrical Test File generated by Etch EDA"
    lines.push "C  Date: 2026-11-09"
    lines.push "P  JOB   #{board.name}"
    lines.push "P  UNITS CUST 0" # Metric units

    for net in board.netlist.allNets()
      netName = net.name.padEnd(14, ' ')

      for pinRef in net.pins
        pad = pinRef.pad
        continue unless pad?

        compRef = pinRef.componentRefDes
        pinNum = pinRef.pinNumber
        refDesPin = "#{compRef}-#{pinNum}".padEnd(14, ' ')

        pos = pad.absolutePosition()
        # Coordinates in tenth-mils or tenths of microns
        # Format coordinate as integer
        xMm = Math.round(pos.x / 1000) # Microns
        yMm = Math.round(pos.y / 1000)

        xStr = "X#{xMm.toString().padStart(7, '0')}"
        yStr = "Y#{yMm.toString().padStart(7, '0')}"

        recType = if pad.isThroughHole() then "317" else "327"
        layerCode = if pad.layerId is 'B.Cu' then "A02" else "A01"

        # Record format: RecType NetName RefDesPin M Layer XCoord YCoord
        lines.push "#{recType} #{netName} #{refDesPin} M #{layerCode} #{xStr} #{yStr}"

    lines.push "999" # End of file
    lines.join("\n") + "\n"

module.exports = IPCD356Exporter
