###
# Etch EDA: RS-274X Extended Gerber Photoplotter Format Generator
#
# Generates industry-standard RS-274X photoplotter files for board fabrication.
# Implements format specification FSLAX46Y46, metric units MOMM, aperture
# dictionaries (%ADD...), drawing commands (D01, D02, D03), and dark/clear polarity.
###

Units = require '../core/units'
{ Point } = require '../core/geometry'

class GerberWriter
  constructor: ->
    @lines = []
    @apertures = new Map() # specKey -> dCode (e.g. "C,0.200000" -> 10)
    @nextDCode = 10
    @currentDCode = -1
    @currentX = null
    @currentY = null

  # Format coordinates for 4.6 metric (e.g. 1.5 mm = 1500000)
  _formatCoord: (nm) ->
    val = Units.toGerberMetric(nm)
    val.toString()

  # Register or retrieve aperture D-code
  getAperture: (type, params) ->
    key = "#{type},#{params.join('X')}"
    if @apertures.has(key)
      return @apertures.get(key)
    dCode = @nextDCode++
    @apertures.set(key, dCode)
    dCode

  startFile: (layerName = 'TOP_COPPER') ->
    @lines.push "G04 Layer: #{layerName}*"
    @lines.push "G04 Generated by Etch EDA - High Precision PCB Engine*"
    @lines.push "%FSLAX46Y46*%" # Format: Absolute, Leading zero omitted, 4.6 metric
    @lines.push "%MOMM*%"      # Units: Millimeters
    @lines.push "%LPD*%"       # Layer Polarity: Dark
    @lines.push "G01*"         # Linear interpolation mode
    @lines.push "G75*"         # Multi-quadrant arc mode

  selectAperture: (dCode) ->
    if @currentDCode isnt dCode
      @lines.push "D#{dCode}*"
      @currentDCode = dCode

  moveTo: (xNm, yNm) ->
    @currentX = xNm
    @currentY = yNm
    @lines.push "X#{@_formatCoord(xNm)}Y#{@_formatCoord(yNm)}D02*"

  drawLineTo: (xNm, yNm) ->
    @currentX = xNm
    @currentY = yNm
    @lines.push "X#{@_formatCoord(xNm)}Y#{@_formatCoord(yNm)}D01*"

  flashAperture: (xNm, yNm) ->
    @currentX = xNm
    @currentY = yNm
    @lines.push "X#{@_formatCoord(xNm)}Y#{@_formatCoord(yNm)}D03*"

  endFile: ->
    @lines.push "M02*" # End of file

  generateString: ->
    headerLines = []
    headerLines.push @lines[0..4]...

    # Output aperture definitions
    for [key, dCode] from @apertures.entries()
      headerLines.push "%ADD#{dCode}#{key}*%"

    bodyLines = @lines[5..]
    all = [headerLines..., bodyLines...]
    all.join("\n") + "\n"


class GerberExporter
  # Generate Gerber RS-274X string for specified copper layer
  @exportCopperLayer: (board, layerId = 'F.Cu') ->
    writer = new GerberWriter()
    writer.startFile("COPPER_#{layerId}")

    # 1. Flash pads on this layer
    for pad in board.allPads()
      continue unless pad.layerId is layerId or pad.isThroughHole()
      pos = pad.absolutePosition()
      wMm = (pad.widthNm / Units.NM_PER_MM).toFixed(6)
      hMm = (pad.heightNm / Units.NM_PER_MM).toFixed(6)

      if pad.shape is 'circle' or pad.widthNm is pad.heightNm
        dCode = writer.getAperture('C', [wMm])
      else
        dCode = writer.getAperture('R', [wMm, hMm])

      writer.selectAperture(dCode)
      writer.flashAperture(pos.x, pos.y)

    # 2. Flash vias
    for via in board.allVias()
      continue unless via.spansLayer(layerId, board.stackup)
      pos = via.position()
      dMm = (via.diameterNm / Units.NM_PER_MM).toFixed(6)
      dCode = writer.getAperture('C', [dMm])
      writer.selectAperture(dCode)
      writer.flashAperture(pos.x, pos.y)

    # 3. Draw routed tracks
    for seg in board.allTraceSegments()
      continue if seg.layerId isnt layerId
      wMm = (seg.widthNm / Units.NM_PER_MM).toFixed(6)
      dCode = writer.getAperture('C', [wMm])
      writer.selectAperture(dCode)
      writer.moveTo(seg.p1.x, seg.p1.y)
      writer.drawLineTo(seg.p2.x, seg.p2.y)

    writer.endFile()
    writer.generateString()

  # Generate Gerber for Solder Mask
  @exportSolderMask: (board, layerId = 'F.Mask') ->
    writer = new GerberWriter()
    writer.startFile(layerId)
    copperLayer = if layerId is 'F.Mask' then 'F.Cu' else 'B.Cu'

    # Solder mask openings for SMD pads and through-hole pads (expanded by 50 um)
    expansionNm = Units.um(50)
    for pad in board.allPads()
      continue unless pad.layerId is copperLayer or pad.isThroughHole()
      pos = pad.absolutePosition()
      wMm = ((pad.widthNm + 2 * expansionNm) / Units.NM_PER_MM).toFixed(6)
      hMm = ((pad.heightNm + 2 * expansionNm) / Units.NM_PER_MM).toFixed(6)

      dCode = if pad.shape is 'circle' or pad.widthNm is pad.heightNm
        writer.getAperture('C', [wMm])
      else
        writer.getAperture('R', [wMm, hMm])

      writer.selectAperture(dCode)
      writer.flashAperture(pos.x, pos.y)

    writer.endFile()
    writer.generateString()

  # Generate Gerber for Edge Cuts (Board Outline)
  @exportEdgeCuts: (board) ->
    writer = new GerberWriter()
    writer.startFile('EDGE_CUTS')

    # 0.1 mm trace for outline cut line
    outlineWidthMm = (Units.mm(0.1) / Units.NM_PER_MM).toFixed(6)
    dCode = writer.getAperture('C', [outlineWidthMm])
    writer.selectAperture(dCode)

    edges = board.outline.edges()
    for edge in edges
      writer.moveTo(edge.p1.x, edge.p1.y)
      writer.drawLineTo(edge.p2.x, edge.p2.y)

    # Also draw cutouts
    for cut in board.cutouts
      for cEdge in cut.edges()
        writer.moveTo(cEdge.p1.x, cEdge.p1.y)
        writer.drawLineTo(cEdge.p2.x, cEdge.p2.y)

    writer.endFile()
    writer.generateString()

module.exports = {
  GerberWriter
  GerberExporter
}
